# .gitignore de Amazon Fill
# La raíz del repositorio ES el proyecto Unity (GDD 08 §3; plan de instalación, "Andamiaje").
# Nunca se ignoran: docs/, schemas/, tools/out/, tools/out_inverse/ ni Packages/com.amazonfill.core/.

# ---------------------------------------------------------------------------
# Unity: carpetas generadas (solo en la raíz)
# ---------------------------------------------------------------------------
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild*/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
# Carpeta temporal que crea Unity 6 en la raíz del proyecto
/.utmp/
# Resultados que escribe `unity test` en la raíz si no se le pasa una ruta (p. ej. las capturas de VisualSnapshotTests);
# scripts/unity-test.ps1 ya los deja en Logs/.
/test-results.xml

# Los .meta se versionan siempre (Visible Meta Files)
!/[Aa]ssets/**/*.meta

# Escena mínima que AF.EditorTools.BuildSmoke genera y borra en cada build de humo
# (por si un build se interrumpe a medias). Va después de la regla de los .meta para que gane.
/[Aa]ssets/_SmokeTemp/
/[Aa]ssets/_SmokeTemp.meta

# PNG de relleno que AF.EditorTools.SizeEstimate (tarea B0) importa y borra al terminar (por si se corta a medias).
/[Aa]ssets/_SizeEstimateTemp/
/[Aa]ssets/_SizeEstimateTemp.meta

# Proyectos y soluciones que Unity genera para el IDE: SOLO en la raíz,
# para que los de dotnet/ y tools/ sigan versionados.
/*.csproj
/*.sln
/*.slnx
/*.unityproj
ExportedObj/
.consulo/

# Plugin de Rider autogenerado
/[Aa]ssets/Plugins/Editor/JetBrains*

# Addressables y Play Asset Delivery: datos empaquetados y temporales
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# Ficheros de depuración y caché de Unity / IDE
*.pidb
*.pidb.meta
*.pdb
*.pdb.meta
*.mdb
*.mdb.meta
*.booproj
*.svd
*.opendb
*.VC.db
*.suo
*.user
*.userprefs
*.tmp
sysinfo.txt
crashlytics-build.properties
.vs/
.idea/
.vscode/
.gradle/

# ---------------------------------------------------------------------------
# Builds y paquetes de distribución (cualquier carpeta)
# ---------------------------------------------------------------------------
*.apk
*.aab
*.apks
*.symbols.zip
*.unitypackage
*.unitypackage.meta
*.app

# ---------------------------------------------------------------------------
# .NET (núcleo compartido y herramientas)
# ---------------------------------------------------------------------------
# Todo bin/obj sale a dotnet/artifacts (ArtifactsPath en dotnet/ y tools/Directory.Build.props)
/dotnet/artifacts/
# Red de seguridad por si algo compila sin los Directory.Build.props
/dotnet/**/[Bb]in/
/dotnet/**/[Oo]bj/
/tools/**/[Bb]in/
/tools/**/[Oo]bj/
[Tt]est[Rr]esults/

# Python (tools/*.py) y Node (functions/, tools/loc-sync)
__pycache__/
*.py[cod]
.venv/
node_modules/

# ---------------------------------------------------------------------------
# Secretos: nunca en git (firmas, licencias, configuraciones de Firebase, entorno)
# ---------------------------------------------------------------------------
*.jks
*.keystore
keystore.properties
*.p12
*.pfx
*.pepk
*.ulf
*.alf
google-services.json
GoogleService-Info.plist
.env*

# ---------------------------------------------------------------------------
# Mapa del río (M5.1): las descargas de Natural Earth y HydroRIVERS (~395 MB) no se versionan.
# Sus SHA-256 y licencias van en tools/river-map/sources.json (sí versionado).
# ---------------------------------------------------------------------------
/tools/river-map/source/

# ---------------------------------------------------------------------------
# Claude Code: estado local de cada agente o persona
# ---------------------------------------------------------------------------
.claude/worktrees/
.claude/settings.local.json
CLAUDE.local.md

# ---------------------------------------------------------------------------
# Sistema operativo
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# BEGIN unity vcs doctor
# Unity ignore rules kept current by `unity vcs doctor --fix`. Managed block: edits here are overwritten. To opt out of a rule, negate it below this block (for example `!*.log`).
*.blend1
*.blend1.meta
*.log
/ServerData
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*
/[Aa]ssets/[Ss]ceneDependencyCache*
InitTestScene*.unity*
mono_crash.*
# END unity vcs doctor
