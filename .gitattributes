# .gitattributes de Amazon Fill
# - Texto: normalizado y con LF en el árbol de trabajo (agentes en Windows, CI en Linux).
# - Binarios de arte, audio, fuentes, vídeo y librerías nativas: Git LFS.
# - Nunca LFS para código, YAML de Unity, .meta ni JSON.
# - `unity vcs merge-setup` (paso s23) añadió al final el bloque gestionado con
#   `merge=unityyamlmerge` para el YAML de Unity; `unity vcs doctor --fix` revisa este archivo.

# Por defecto, git decide si es texto y lo guarda con LF en el repositorio
* text=auto

# ---------------------------------------------------------------------------
# Código y configuración: siempre LF
# ---------------------------------------------------------------------------
*.cs            text eol=lf diff=csharp
*.csproj        text eol=lf
*.props         text eol=lf
*.targets       text eol=lf
*.sln           text eol=lf
*.slnx          text eol=lf
*.asmdef        text eol=lf
*.asmref        text eol=lf
*.rsp           text eol=lf
*.editorconfig  text eol=lf
.editorconfig   text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf
*.json          text eol=lf
*.md            text eol=lf diff=markdown
*.txt           text eol=lf
*.xml           text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.py            text eol=lf diff=python
*.ps1           text eol=lf
*.sh            text eol=lf
# Parches de traspaso (docs/dev/traspaso): con CRLF, git apply no casa con los .cs en LF
*.patch         text eol=lf
*.diff          text eol=lf
*.js            text eol=lf
*.mjs           text eol=lf
*.ts            text eol=lf
*.html          text eol=lf
*.css           text eol=lf
*.csv           text eol=lf
*.gradle        text eol=lf
*.properties    text eol=lf
*.pro           text eol=lf
*.plist         text eol=lf
*.xcprivacy     text eol=lf
*.java          text eol=lf
*.kt            text eol=lf

# Shaders (texto) y UI Toolkit
*.shader          text eol=lf
*.hlsl            text eol=lf
*.cginc           text eol=lf
*.compute         text eol=lf
*.shadergraph     text eol=lf
*.shadersubgraph  text eol=lf
*.uxml            text eol=lf
*.uss             text eol=lf

# ---------------------------------------------------------------------------
# YAML de Unity (Asset Serialization = Force Text) y .meta: LF, nunca LFS
# ---------------------------------------------------------------------------
*.meta                 text eol=lf
*.unity                text eol=lf
*.prefab               text eol=lf
*.asset                text eol=lf
*.mat                  text eol=lf
*.anim                 text eol=lf
*.controller           text eol=lf
*.overrideController   text eol=lf
*.physicMaterial       text eol=lf
*.physicsMaterial2D    text eol=lf
*.playable             text eol=lf
*.mask                 text eol=lf
*.brush                text eol=lf
*.flare                text eol=lf
*.fontsettings         text eol=lf
*.guiskin              text eol=lf
*.giparams             text eol=lf
*.renderTexture        text eol=lf
*.spriteatlas          text eol=lf
*.spriteatlasv2        text eol=lf
*.terrainlayer         text eol=lf
*.mixer                text eol=lf
*.shadervariants       text eol=lf
*.preset               text eol=lf
*.lighting             text eol=lf
*.signal               text eol=lf
*.cubemap              text eol=lf
*.inputactions         text eol=lf
# Excepción: los datos de iluminación horneada se guardan en binario aunque sean .asset
LightingData.asset     binary
# TextAsset binario de Unity
*.bytes                binary

# ---------------------------------------------------------------------------
# Git LFS: binarios
# ---------------------------------------------------------------------------
# Imagen y arte 2D
*.png   filter=lfs diff=lfs merge=lfs -text
*.jpg   filter=lfs diff=lfs merge=lfs -text
*.jpeg  filter=lfs diff=lfs merge=lfs -text
*.psd   filter=lfs diff=lfs merge=lfs -text
*.psb   filter=lfs diff=lfs merge=lfs -text
*.tga   filter=lfs diff=lfs merge=lfs -text
*.tif   filter=lfs diff=lfs merge=lfs -text
*.tiff  filter=lfs diff=lfs merge=lfs -text
*.exr   filter=lfs diff=lfs merge=lfs -text
*.hdr   filter=lfs diff=lfs merge=lfs -text
*.webp  filter=lfs diff=lfs merge=lfs -text
*.gif   filter=lfs diff=lfs merge=lfs -text
# Modelos
*.fbx   filter=lfs diff=lfs merge=lfs -text
# Audio
*.wav   filter=lfs diff=lfs merge=lfs -text
*.ogg   filter=lfs diff=lfs merge=lfs -text
*.mp3   filter=lfs diff=lfs merge=lfs -text
*.aif   filter=lfs diff=lfs merge=lfs -text
*.aiff  filter=lfs diff=lfs merge=lfs -text
*.flac  filter=lfs diff=lfs merge=lfs -text
*.m4a   filter=lfs diff=lfs merge=lfs -text
# Fuentes
*.ttf   filter=lfs diff=lfs merge=lfs -text
*.otf   filter=lfs diff=lfs merge=lfs -text
*.ttc   filter=lfs diff=lfs merge=lfs -text
# Vídeo
*.mp4   filter=lfs diff=lfs merge=lfs -text
*.mov   filter=lfs diff=lfs merge=lfs -text
*.webm  filter=lfs diff=lfs merge=lfs -text
# Librerías nativas y de plugins (Android y .NET precompiladas)
*.aar   filter=lfs diff=lfs merge=lfs -text
*.jar   filter=lfs diff=lfs merge=lfs -text
*.so    filter=lfs diff=lfs merge=lfs -text
*.dll   filter=lfs diff=lfs merge=lfs -text
# Paquetes UPM descargados y versionados (D-039: Firebase Unity SDK 13.17.0 y EDM4U 1.2.189, por file: en Packages/manifest.json)
/Packages/firebase/*.tgz  filter=lfs diff=lfs merge=lfs -text
# D-042: Play Games plugin for Unity 2.3.0, reempaquetado desde el .unitypackage oficial (docs/dev/play-games.md §2)
/Packages/playgames/*.tgz  filter=lfs diff=lfs merge=lfs -text
# D-042: AppLovin MAX Unity Plugin 8.6.6 (registro UPM oficial de AppLovin), por file: en Packages/manifest.json
/Packages/applovin/*.tgz  filter=lfs diff=lfs merge=lfs -text

# BEGIN unity vcs merge-setup
# Unity scene and prefab merging. Managed block: edits here are overwritten.
*.anim merge=unityyamlmerge
*.asset merge=unityyamlmerge
*.controller merge=unityyamlmerge
*.mat merge=unityyamlmerge
*.physicMaterial merge=unityyamlmerge
*.prefab merge=unityyamlmerge
*.unity merge=unityyamlmerge
# END unity vcs merge-setup

# Excepción posterior al bloque gestionado (git aplica la última regla que coincide):
# los datos de iluminación horneada son binarios y no pasan por UnityYAMLMerge.
LightingData.asset     binary

# Excepción: archivos que un plugin reescribe en cada build con el fin de línea de la plataforma (Environment.NewLine: CRLF en
# Windows, LF en Linux). GPGSProjectSettings.Save (Play Games 2.3.0) escribe GooglePlayGameSettings.txt con StreamWriter.WriteLine,
# y el resolvedor de Android de EDM4U 1.2.189, AndroidResolverDependencies.xml (comprobado con un build de desarrollo en Windows:
# solo cambia el fin de línea).
# Con eol=lf, el CRLF de Windows deja el archivo como modificado tras cada build; con eol=crlf pasaría lo mismo en el CI Linux.
# `text !eol`: en el repositorio, LF; en el árbol de trabajo, el fin de línea nativo (core.eol; CRLF en Windows con
# core.autocrlf=true o native, LF en Linux), el mismo que escribe el plugin, así que el build no deja el árbol sucio en ninguno.
# Prueba del 2026-10-23, observación 2. No se editan a mano (regla dura 3).
/ProjectSettings/GooglePlayGameSettings.txt  text !eol
/ProjectSettings/AndroidResolverDependencies.xml  text !eol
