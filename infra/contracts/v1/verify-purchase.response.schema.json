{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.invalid/af/v1/verify-purchase.response.schema.json",
  "title": "verifyPurchase: respuesta 200",
  "description": "08 §10.3: ok concede; pending no concede (la transacción sigue en Unity IAP); duplicate, el token ya está en el libro mayor de este UID.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "token_hash",
        "grant"
      ],
      "properties": {
        "status": {
          "const": "ok"
        },
        "token_hash": {
          "$ref": "common.schema.json#/$defs/tokenHash"
        },
        "grant": {
          "$ref": "#/$defs/grant"
        },
        "entitlements": {
          "$ref": "#/$defs/entitlements"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "const": "pending"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "token_hash"
      ],
      "properties": {
        "status": {
          "const": "duplicate"
        },
        "token_hash": {
          "$ref": "common.schema.json#/$defs/tokenHash"
        }
      }
    }
  ],
  "$defs": {
    "grant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seeds",
        "items"
      ],
      "properties": {
        "seeds": {
          "type": "integer",
          "minimum": 0
        },
        "items": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "count"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9_]{1,40}$"
              },
              "count": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      },
      "description": "Lo que acredita el cliente (08 §10.3: grant {seeds, items})."
    },
    "entitlements": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "no_ads": {
          "type": "boolean"
        },
        "pass_until": {
          "$ref": "common.schema.json#/$defs/epochMs"
        },
        "skins": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_]{1,40}$"
          }
        }
      },
      "description": "Derechos del UID tras la compra (08 §10.3: no_ads, pass_until, skins) [P]."
    }
  }
}
