{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.invalid/af/v1/restore-ledger.response.schema.json",
  "title": "restoreLedger: respuesta 200",
  "description": "Compras del UID (índice by_uid de purchases) con su estado, y los nonces de pending_nonces que el servidor tiene confirmados en rewards para este UID. Los no devueltos siguen sin confirmar.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "purchases",
    "confirmed_nonces"
  ],
  "properties": {
    "purchases": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "token_hash",
          "sku",
          "state",
          "ts"
        ],
        "properties": {
          "token_hash": {
            "$ref": "common.schema.json#/$defs/tokenHash"
          },
          "sku": {
            "$ref": "common.schema.json#/$defs/sku"
          },
          "state": {
            "enum": [
              "ok",
              "voided"
            ]
          },
          "ts": {
            "$ref": "common.schema.json#/$defs/epochMs"
          },
          "voided_at": {
            "$ref": "common.schema.json#/$defs/epochMs"
          }
        }
      }
    },
    "confirmed_nonces": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 200,
      "items": {
        "$ref": "common.schema.json#/$defs/nonce"
      }
    }
  }
}
