{
  "name": "af-infra",
  "version": "0.1.0",
  "private": true,
  "description": "Infraestructura de Amazon Fill en AWS (D-035): CDK v2 en TypeScript. Solo se valida sin credenciales; despliega el dueño.",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/src/browser/tsconfig.json",
    "test": "vitest run",
    "synth": "cdk synth",
    "web:build": "node web/build.ts",
    "web:check": "node web/build.ts --check"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1146.0",
    "@aws-sdk/client-secrets-manager": "3.1146.0",
    "@aws-sdk/lib-dynamodb": "3.1146.0",
    "aws-cdk-lib": "2.272.0",
    "cdk-nag": "3.0.2",
    "constructs": "10.8.1",
    "jose": "6.2.12"
  },
  "devDependencies": {
    "@types/aws-lambda": "8.10.164",
    "@types/node": "24.19.1",
    "ajv": "8.20.0",
    "aws-cdk": "2.1144.0",
    "aws-sdk-client-mock": "4.1.0",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
