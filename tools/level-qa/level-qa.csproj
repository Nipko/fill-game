<Project Sdk="Microsoft.NET.Sdk">
  <!-- Control de calidad de paquetes de niveles (GDD 08 §2.4). Falla el CI si algo no cumple. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>level-qa</AssemblyName>
    <RootNamespace>AmazonFill.Tools.LevelQa</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../dotnet/AF.Core/AF.Core.csproj" />
    <ProjectReference Include="../../dotnet/AF.Solver/AF.Solver.csproj" />
  </ItemGroup>

  <!-- Un solo lector de la especificación de la campaña y unas mismas métricas para el generador y el QA:
       se enlazan los fuentes de tools/level-generator (no se copian). -->
  <ItemGroup>
    <Compile Include="../level-generator/Campaign/CampaignSpec.cs" Link="Shared/CampaignSpec.cs" />
    <Compile Include="../level-generator/Campaign/SpecValidator.cs" Link="Shared/SpecValidator.cs" />
    <Compile Include="../level-generator/Campaign/BoardShape.cs" Link="Shared/BoardShape.cs" />
    <Compile Include="../level-generator/Metrics/Metrics.cs" Link="Shared/Metrics.cs" />
    <Compile Include="../level-generator/Metrics/ReferencePath.cs" Link="Shared/ReferencePath.cs" />
    <Compile Include="../level-generator/Metrics/Relief.cs" Link="Shared/Relief.cs" />
  </ItemGroup>

  <!-- La compuerta regenera la campaña en memoria para comprobar la reproducibilidad (QA-REPRO, 03 §17 #10) y medir la
       banda de cada nivel en el pool (QA-BAND-Q, 03 §7): el mismo código de generación, enlazado. -->
  <ItemGroup>
    <!-- SeasonTableWriter (la tabla de temporada del generador) no lo usa la compuerta: se queda fuera. -->
    <Compile Include="../level-generator/Generation/*.cs" Exclude="../level-generator/Generation/SeasonTableWriter.cs" LinkBase="Shared/Generation" />
  </ItemGroup>
</Project>
