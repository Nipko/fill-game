<Project Sdk="Microsoft.NET.Sdk">
  <!-- Generador offline de niveles (GDD 08 §2.4, GDD 03). Usa las mismas reglas que el cliente. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>level-generator</AssemblyName>
    <RootNamespace>AmazonFill.Tools.LevelGenerator</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../dotnet/AF.Core/AF.Core.csproj" />
    <ProjectReference Include="../../dotnet/AF.Solver/AF.Solver.csproj" />
  </ItemGroup>
</Project>
