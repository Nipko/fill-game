diff --git a/Packages/com.amazonfill.core/Tests/Editor/AF.Solver.Tests/ShufflerTests.cs b/Packages/com.amazonfill.core/Tests/Editor/AF.Solver.Tests/ShufflerTests.cs
new file mode 100644
