+
+        [Test]
+        public void HiddenDoses_AreRevealedByTheWave_04_2_4_a()
+        {
+            BoardState board = new BoardState(new[]
+            {
+                Cuia.Create(4, new[] { 1, 2, 3, 4 }, 0b0011), C(4, 5, 6, 1, 2), Cuia.Create(4, new[] { 3, 4, 5, 6 }, 0b0001),
