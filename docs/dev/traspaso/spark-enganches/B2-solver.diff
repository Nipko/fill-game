diff --git a/Packages/com.amazonfill.core/Tests/Editor/AF.Core.Tests/LevelSessionShuffleTests.cs b/Packages/com.amazonfill.core/Tests/Editor/AF.Core.Tests/LevelSessionShuffleTests.cs
