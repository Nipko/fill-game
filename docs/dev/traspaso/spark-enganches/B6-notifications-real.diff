diff --git a/Assets/_Project/Scripts/UI/GameBootstrap.Notifications.cs b/Assets/_Project/Scripts/UI/GameBootstrap.Notifications.cs
new file mode 100644
index 0000000..e9d238e
--- /dev/null
+++ b/Assets/_Project/Scripts/UI/GameBootstrap.Notifications.cs
@@ -0,0 +1,36 @@
+#nullable enable
+using AF.Localization;
+using AF.Platform;
+using UnityEngine;
+
+namespace AF.UI
+{
+    /// <summary>
+    /// El programador real de los avisos (parche B6-notifications-real; Q-M5 de D-033): implementa los ganchos
+    /// <c>CreatePlatformScheduler</c> y <c>TickPlatformScheduler</c> de <c>GameBootstrap.Sessions.cs</c> con
+    /// <see cref="AndroidNotificationScheduler"/>, solo en el teléfono y con el paquete <c>com.unity.mobile.notifications</c>
+    /// (<c>AF_MOBILE_NOTIFICATIONS</c>). En el editor, y sin el paquete, sigue el <see cref="FakeNotificationScheduler"/>.
+    /// </summary>
+    public sealed partial class GameBootstrap
+    {
+        static partial void CreatePlatformScheduler(IClock clock, ref INotificationScheduler? scheduler)
+        {
+#if AF_MOBILE_NOTIFICATIONS && UNITY_ANDROID
+            if (!Application.isEditor)
+            {
+                // Nombre y descripción del canal, como los ve el jugador en los ajustes del teléfono (claves de B6-strings.csv).
+                string name = Loc.Has("push_channel_name") ? Loc.T("push_channel_name") : string.Empty;
+                string description = Loc.Has("push_channel_description") ? Loc.T("push_channel_description") : string.Empty;
+                scheduler = new AndroidNotificationScheduler(clock, name, description);
+            }
+#endif
+        }
+
+        partial void TickPlatformScheduler()
+        {
+#if AF_MOBILE_NOTIFICATIONS && UNITY_ANDROID
+            (_notificationScheduler as AndroidNotificationScheduler)?.Poll();
+#endif
+        }
+    }
+}
