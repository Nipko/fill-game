diff --git a/Assets/_Project/Scripts/Save/ProfileJson.cs b/Assets/_Project/Scripts/Save/ProfileJson.cs
index aac65ecd..be08878e 100644
--- a/Assets/_Project/Scripts/Save/ProfileJson.cs
+++ b/Assets/_Project/Scripts/Save/ProfileJson.cs
@@ -210,6 +210,7 @@ internal static JsonNode ToNode(Profile p)
                 root.Set("daily_challenge", DailyChallengeNode(p.DailyChallenge)); // E4: la clave falta hasta el primer guardado del Reto
             }
 
+            WriteB8(root, p); // B8: identidad, compras, recompensas provisionales e integrity, omitidos en su default
