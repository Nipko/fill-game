+        /// <summary>
+        /// La tienda verificada bajo los envoltorios conocidos (el consentimiento de B12 y la tienda lista de D-040), para oír lo que se
+        /// acredita fuera de una compra abierta: sin esto, con el consentimiento activo o con Play real, los pagos pendientes (OXXO, PSE…)
+        /// que Play cobra después nunca darían <c>af_iap_result</c> ni <c>purchase</c> (08 §8.2).
+        /// </summary>
+        internal static VerifiedStoreService? FindVerified(IStoreService store)
+        {
+            IStoreService? current = store;
+            for (int depth = 0; depth < 8 && current != null; depth++)
+            {
+                switch (current)
+                {
+                    case VerifiedStoreService verified:
+                        return verified;
+                    case ConsentStoreService consent:
+                        current = consent.Inner;
+                        break;
+                    case BillingReadyStoreService ready:
+                        current = ready.Inner;
+                        break;
+                    default:
+                        return null;
+                }
+            }
+
+            return null;
+        }
