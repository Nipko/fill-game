+#nullable enable
+using AF.GameFlow;
+using AF.IAP;
+using AF.Save;
+
+namespace AF.UI
+{
+    /// <summary>
+    /// Enganche B5-profile (bloque B5): el Cántaro y las ofertas se guardan en los bloques <c>piggy</c> y <c>offers</c> del mismo
+    /// perfil que la cartera, por la vía síncrona del lote (<see cref="ProfileSaveBatch.Durable"/>): el Cántaro y la compra que lo
+    /// vacía salen juntos en disco. Implementa el gancho de <c>GameBootstrap.Market.cs</c>.
+    /// </summary>
+    public sealed partial class GameBootstrap
+    {
+        static partial void CreateProfileOffersStore(Profile profile, ProfileSaveBatch batch, ref IOffersStore? store)
+        {
+            store = new ProfileOffersStore(profile, batch.Durable);
+        }
+    }
+}
