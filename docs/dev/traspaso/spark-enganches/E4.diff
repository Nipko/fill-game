diff --git a/Assets/_Project/Scripts/Save/Profile.cs b/Assets/_Project/Scripts/Save/Profile.cs
index 8ed84df..8c78d8f 100644
--- a/Assets/_Project/Scripts/Save/Profile.cs
+++ b/Assets/_Project/Scripts/Save/Profile.cs
@@ -72,6 +72,15 @@ public sealed class Profile
         /// <summary><c>stats</c>: contadores agregados (nunca por nivel: eso va a analítica, 08 §4.3).</summary>
         public StatsData Stats { get; } = new StatsData();
 
