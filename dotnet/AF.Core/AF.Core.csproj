<Project Sdk="Microsoft.NET.Sdk">
  <!--
    AF.Core compilado por dotnet. No tiene fuentes propios: enlaza los .cs del paquete Unity
    (Packages/com.aquazonia.core/Runtime/AF.Core), que es la única copia del código.
    No añadir aquí ImplicitUsings ni Nullable: pisarían dotnet/Directory.Build.props.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>AF.Core</AssemblyName>
    <RootNamespace>AF.Core</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(AfPackageDir)Runtime/AF.Core/**/*.cs" Link="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
